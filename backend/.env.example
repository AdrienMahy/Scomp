# Database Configuration
TACTICAL_DATABASE_URL=postgresql://scrapper:your_password_here@localhost:5432/TacticalData
PHYSICAL_DATABASE_URL=postgresql://scrapper:your_password_here@localhost:5432/PhysicalData

# SportsDynamics API
SPORTSDYNAMICS_API_KEY=your_api_key_here
